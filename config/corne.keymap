#define ___ &trans

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_5col_layout;
    };

    behaviors {
        mod: mod {
            compatible = "zmk,behavior-hold-tap";
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        layer: layer {
            compatible = "zmk,behavior-hold-tap";
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_bluetooth {
            timeout-ms = <50>;
            key-positions = <20 21 22 23>;
            bindings = <&mo 2>;
            require-prior-idle-ms = <1000>;
        };
        combo_kanata {
            timeout-ms = <50>;
            key-positions = <26 27 28 29>;
            bindings = <&tog 1>;
            require-prior-idle-ms = <1000>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        kanata {
            bindings = <
&kp Q               &kp W               &kp E               &kp R               &kp T               &kp U               &kp I               &kp O               &kp P               &kp LBKT
&kp A               &kp S               &kp D               &kp F               &kp G               &kp J               &kp K               &kp L               &kp SEMI            &kp SQT
&kp LSFT            &kp Z               &kp X               &kp C               &kp V               &kp M               &kp COMMA           &kp DOT             &kp FSLH            &kp RSFT
                                        ___                 &kp SPACE           &kp LGUI            &kp RALT            &kp RGUI            ___
            >;
        };

        colemak {
            bindings = <
&kp Q               &kp W               &layer 3 F          &kp P               &kp B               &kp J               &kp L               &layer 3 U          &kp Y               &kp SQT
&mod LALT A         &mod LCTRL R        &mod LGUI S         &mod LSHIFT T       &kp G               &kp M               &mod LSHIFT N       &mod LGUI E         &mod LCTRL I        &mod LALT O
&kp Z               &kp X               &kp C               &mod LS(LC(LALT)) D &kp V               &kp K               &mod LS(LC(LALT)) H &kp COMMA           &kp DOT             &kp FSLH
                                        ___                 &layer 2 SPACE      &kp ESC             &kp RET             &layer 2 BSPC       ___
            >;
        };

        num_nav {
            bindings = <
___                 &kp N7              &kp N8              &kp N9              ___                 ___                 ___                 &kp LS(TAB)         &kp TAB             ___
&kp N0              &kp N4              &kp N5              &kp N6              ___                 &kp LEFT            &kp DOWN            &kp UP              &kp RIGHT           &kp DEL
___                 &kp N1              &kp N2              &kp N3              ___                 &kp HOME            &kp PG_DN           &kp PG_UP           &kp END             ___
                                        ___                 ___                 ___                 ___                 ___                 ___
            >;
        };

        sym {
            bindings = <
&kp TILDE           &kp HASH            &kp STAR            &kp PLUS            ___                 ___                 &kp GRAVE           &kp LBKT            &kp RBKT            &kp AT
&kp EQUAL           &kp CARET           &kp DLLR            &kp MINUS           ___                 ___                 &kp COLON           &kp LPAR            &kp RPAR            &kp SEMI
&kp PRCNT           &kp PIPE            &kp AMPS            &kp EXCL            ___                 ___                 &kp UNDER           &kp LBRC            &kp RBRC            &kp BSLH
                                        ___                 ___                 ___                 ___                 ___                 ___
            >;
        };

        bluetooth {
            bindings = <
___                 ___                 ___                 ___                 ___                 ___                 ___                 ___                 ___                 ___
___                 ___                 ___                 ___                 ___                 ___                 &bt BT_NXT          &bt BT_PRV          ___                 ___
___                 ___                 ___                 ___                 ___                 ___                 ___                 ___                 ___                 &bt BT_CLR
                                        ___                 ___                 ___                 ___                 ___                 ___
            >;
        };
    };
};
