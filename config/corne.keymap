#define ___ &trans

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_5col_layout;
    };

    behaviors {
        mod: mod {
            compatible = "zmk,behavior-hold-tap";
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        layer: layer {
            compatible = "zmk,behavior-hold-tap";
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_bluetooth {
            timeout-ms = <50>;
            key-positions = <0 1 2 3 30>;
            bindings = <&mo 2>;
            require-prior-idle-ms = <1000>;
        };
        combo_kanata {
            timeout-ms = <50>;
            key-positions = <0 1 2 3>;
            bindings = <&tog 1>;
            require-prior-idle-ms = <1000>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        kanata {
            bindings = <
&kp Q               &kp W               &kp E               &kp R               &kp T               &kp U               &kp I               &kp O               &kp P               &kp LBKT
&kp A               &kp S               &kp D               &kp F               &kp G               &kp J               &kp K               &kp L               &kp SEMI            &kp SQT
&kp LSFT            &kp Z               &kp X               &kp C               &kp V               &kp M               &kp COMMA           &kp DOT             &kp FSLH            &kp RSFT
                                        &kp LGUI            &kp SPACE           &kp ESC             &kp RET             &kp RGUI            &kp RALT
            >;
        };

        colemak {
            bindings = <
&kp Q               &kp W               &kp F               &kp P               &kp B               &kp J               &kp L               &kp U               &kp Y               &kp SQT
&kp A               &layer 3 R          &kp S               &kp T               &kp G               &kp M               &kp N               &kp E               &kp I               &kp O
&mod LSHIFT Z       &mod LCTRL X        &mod LGUI C         &mod LALT D         &kp V               &kp K               &mod LALT H         &mod LGUI COMMA     &mod LCTRL DOT      &mod LSHIFT FSLH
                                        &kp TAB             &layer 2 SPACE      &kp ESC             &kp RET             &layer 2 BSPC       &kp DEL
            >;
        };

        num_nav {
            bindings = <
___                 &kp N7              &kp N8              &kp N9              ___                 ___                 ___                 &kp PG_UP           &kp PG_DN           ___
&kp N0              &kp N4              &kp N5              &kp N6              ___                 &kp LEFT            &kp DOWN            &kp UP              &kp RIGHT           ___
___                 &kp N1              &kp N2              &kp N3              ___                 ___                 ___                 &kp HOME            &kp END             ___
                                        ___                 ___                 ___                 ___                 ___                 ___
            >;
        };

        sym {
            bindings = <
&kp TILDE           &kp HASH            &kp STAR            &kp PLUS            ___                 ___                 &kp AT              &kp LBKT            &kp RBKT            &kp GRAVE
&kp EQUAL           &kp CARET           &kp DLLR            &kp MINUS           ___                 ___                 &kp COLON           &kp LPAR            &kp RPAR            &kp SEMI
&kp EXCL            &kp PIPE            &kp AMPS            &kp PRCNT           ___                 ___                 &kp UNDER           &kp LBRC            &kp RBRC            &kp BSLH
                                        ___                 ___                 ___                 ___                 ___                 ___
            >;
        };

        bluetooth {
            bindings = <
___                 ___                 ___                 ___                 ___                 ___                 ___                 ___                 ___                 ___
___                 ___                 ___                 ___                 ___                 ___                 &bt BT_NXT          &bt BT_PRV          ___                 ___
___                 ___                 ___                 ___                 ___                 ___                 ___                 ___                 ___                 &bt BT_CLR
                                        ___                 ___                 ___                 ___                 ___                 ___
            >;
        };
    };
};
