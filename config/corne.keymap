#define ___ &trans

// Keep these indices in sync with the layer order in keymap below.
#define L_BASE 0
#define L_NN 1
#define L_SYM 2
#define L_MOUSE 3
#define L_MED 4
#define L_FUN 5
#define L_BLUETOOTH 6

#define CK_PRIOR_IDLE 150
#define CK_QUICK_TAP 200
#define CK_LEFT_HAND_KEYS 0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32
#define CK_RIGHT_HAND_KEYS 5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_5col_layout;
    };

    // l/r = hand, m = modifier, l = layer, i = prior idle; tl = thumb layer.
    behaviors {
        lm: lm {
            compatible = "zmk,behavior-hold-tap";
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <CK_QUICK_TAP>;
            hold-trigger-key-positions = <CK_RIGHT_HAND_KEYS>;
            hold-trigger-on-release;
        };

        rm: rm {
            compatible = "zmk,behavior-hold-tap";
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <CK_QUICK_TAP>;
            hold-trigger-key-positions = <CK_LEFT_HAND_KEYS>;
            hold-trigger-on-release;
        };

        lmi: lmi {
            compatible = "zmk,behavior-hold-tap";
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <CK_QUICK_TAP>;
            require-prior-idle-ms = <CK_PRIOR_IDLE>;
            hold-trigger-key-positions = <CK_RIGHT_HAND_KEYS>;
            hold-trigger-on-release;
        };

        rmi: rmi {
            compatible = "zmk,behavior-hold-tap";
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <CK_QUICK_TAP>;
            require-prior-idle-ms = <CK_PRIOR_IDLE>;
            hold-trigger-key-positions = <CK_LEFT_HAND_KEYS>;
            hold-trigger-on-release;
        };

        // Thumb layer-taps are not restricted to the opposite hand.
        tl: tl {
            compatible = "zmk,behavior-hold-tap";
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <CK_QUICK_TAP>;
        };

        ll: ll {
            compatible = "zmk,behavior-hold-tap";
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <CK_QUICK_TAP>;
            hold-trigger-key-positions = <CK_RIGHT_HAND_KEYS>;
            hold-trigger-on-release;
        };

        rl: rl {
            compatible = "zmk,behavior-hold-tap";
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <CK_QUICK_TAP>;
            hold-trigger-key-positions = <CK_LEFT_HAND_KEYS>;
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_media {
            timeout-ms = <40>;
            key-positions = <12 23>;
            bindings = <&mo L_MED>;
            slow-release;
            require-prior-idle-ms = <CK_PRIOR_IDLE>;
        };
        combo_function {
            timeout-ms = <40>;
            key-positions = <17 26>;
            bindings = <&mo L_FUN>;
            slow-release;
            require-prior-idle-ms = <CK_PRIOR_IDLE>;
        };
        combo_bluetooth {
            timeout-ms = <50>;
            key-positions = <0 1 2 3 30>;
            bindings = <&mo L_BLUETOOTH>;
            require-prior-idle-ms = <1000>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        colemak {
            bindings = <
&kp Q               &kp W               &kp F               &kp P               &kp B               &kp J               &kp L               &kp U               &kp Y               &kp SQT
&kp A               &ll L_SYM R         &kp S               &kp T               &kp G               &kp M               &kp N               &kp E               &rl L_SYM I         &kp O
&lm LSHIFT Z        &lmi LCTRL X        &lmi LGUI C         &lmi LALT D         &kp V               &kp K               &rmi LALT H         &rmi LGUI COMMA     &rmi LCTRL DOT      &rm LSHIFT FSLH
                                        ___                 &tl L_NN SPACE      &kp ESC             &tl L_MOUSE RET     &tl L_NN BSPC       ___
            >;
        };

        num_nav {
            bindings = <
___                 &kp N7              &kp N8              &kp N9              &kp CAPS            ___                 ___                 &kp PG_UP           &kp PG_DN           ___
&kp N0              &kp N4              &kp N5              &kp N6              &caps_word          &kp LEFT            &kp DOWN            &kp UP              &kp RIGHT           &kp DEL
___                 &lm LCTRL N1        &lm LGUI N2         &lm LALT N3         ___                 ___                 ___                 &rm LGUI HOME       &rm LCTRL END       ___
                                        ___                 ___                 ___                 &kp LS(TAB)         &kp TAB             ___
            >;
        };

        sym {
            bindings = <
&kp TILDE           &kp HASH            &kp STAR            &kp PLUS            ___                 ___                 &kp AT              &kp LBKT            &kp RBKT            &kp GRAVE
&kp EQUAL           &kp CARET           &kp DLLR            &kp MINUS           ___                 ___                 &kp COLON           &kp LPAR            &kp RPAR            &kp SEMI
&lm LSHIFT EXCL     &lm LCTRL PIPE      &lm LGUI AMPS       &lm LALT PRCNT      ___                 ___                 &rm LALT UNDER      &rm LGUI LBRC       &rm LCTRL RBRC      &rm LSHIFT BSLH
                                        ___                 ___                 ___                 ___                 ___                 ___
            >;
        };

        mouse {
            bindings = <
___                 &mkp MB4            &mmv MOVE_UP        &mkp MB5            ___                 ___                 ___                 ___                 ___                 ___
___                 &mmv MOVE_LEFT      &mmv MOVE_DOWN      &mmv MOVE_RIGHT     &mkp MCLK           ___                 ___                 ___                 ___                 ___
___                 &msc SCRL_LEFT      &msc SCRL_UP        &msc SCRL_DOWN      &msc SCRL_RIGHT     ___                 ___                 ___                 ___                 ___
                                        ___                 &mkp LCLK           &mkp RCLK           ___                 ___                 ___
            >;
        };

        media {
            bindings = <
___                 ___                 ___                 ___                 ___                 ___                 ___                 ___                 ___                 ___
___                 ___                 ___                 ___                 ___                 &kp C_PREV          &kp C_VOL_DN        &kp C_VOL_UP        &kp C_NEXT          ___
___                 ___                 ___                 ___                 ___                 &kp C_PP            &kp C_BRI_DN        &kp C_BRI_UP        &kp C_MUTE          &kp LC(LS(C_EJECT))
                                        ___                 ___                 ___                 ___                 ___                 ___
            >;
        };

        function {
            bindings = <
&kp F12             &kp F7              &kp F8              &kp F9              ___                 ___                 ___                 ___                 ___                 ___
&kp F11             &kp F4              &kp F5              &kp F6              ___                 ___                 ___                 ___                 ___                 ___
&kp F10             &kp F1              &kp F2              &kp F3              ___                 ___                 ___                 ___                 ___                 ___
                                        ___                 ___                 ___                 ___                 ___                 ___
            >;
        };

        bluetooth {
            bindings = <
___                 ___                 ___                 ___                 ___                 ___                 ___                 ___                 ___                 ___
___                 ___                 ___                 ___                 ___                 ___                 &bt BT_NXT          &bt BT_PRV          ___                 ___
___                 ___                 ___                 ___                 ___                 ___                 ___                 ___                 ___                 &bt BT_CLR
                                        ___                 ___                 ___                 ___                 ___                 ___
            >;
        };
    };
};
