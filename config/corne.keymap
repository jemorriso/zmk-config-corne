#define ___ &trans

// Keep these indices in sync with the layer order in keymap below.
#define L_BASE 0
#define L_NN 1
#define L_SYM 2
#define L_BLUETOOTH 3

#define CK_PRIOR_IDLE 150

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_5col_layout;
    };

    behaviors {
        mod: mod {
            compatible = "zmk,behavior-hold-tap";
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        mod_rpi: mod_rpi {
            compatible = "zmk,behavior-hold-tap";
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            require-prior-idle-ms = <CK_PRIOR_IDLE>;
        };

        layer: layer {
            compatible = "zmk,behavior-hold-tap";
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        layer_rpi: layer_rpi {
            compatible = "zmk,behavior-hold-tap";
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            require-prior-idle-ms = <CK_PRIOR_IDLE>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_bluetooth {
            timeout-ms = <50>;
            key-positions = <0 1 2 3 30>;
            bindings = <&mo L_BLUETOOTH>;
            require-prior-idle-ms = <1000>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        colemak {
            bindings = <
&kp Q               &kp W               &kp F               &kp P               &kp B               &kp J               &kp L               &kp U               &kp Y               &kp SQT
&kp A               &layer L_SYM R      &kp S               &kp T               &kp G               &kp M               &kp N               &kp E               &layer L_SYM I      &kp O
&mod LSHIFT Z       &mod_rpi LCTRL X    &mod_rpi LGUI C     &mod_rpi LALT D     &kp V               &kp K               &mod_rpi LALT H     &mod_rpi LGUI COMMA &mod_rpi LCTRL DOT  &mod LSHIFT FSLH
                                        ___                 &layer L_NN SPACE   &kp ESC             &kp RET             &layer L_NN BSPC    ___
            >;
        };

        num_nav {
            bindings = <
___                 &kp N7              &kp N8              &kp N9              &kp CAPS            ___                 ___                 &kp PG_UP           &kp PG_DN           ___
&kp N0              &kp N4              &kp N5              &kp N6              &caps_word          &kp LEFT            &kp DOWN            &kp UP              &kp RIGHT           &kp DEL
___                 &mod LCTRL N1       &mod LGUI N2        &mod LALT N3        ___                 ___                 ___                 &mod LGUI HOME      &mod LCTRL END      ___
                                        ___                 ___                 ___                 &kp LS(TAB)         &kp TAB             ___
            >;
        };

        sym {
            bindings = <
&kp TILDE           &kp HASH            &kp STAR            &kp PLUS            ___                 ___                 &kp AT              &kp LBKT            &kp RBKT            &kp GRAVE
&kp EQUAL           &kp CARET           &kp DLLR            &kp MINUS           ___                 ___                 &kp COLON           &kp LPAR            &kp RPAR            &kp SEMI
&mod LSHIFT EXCL    &mod LCTRL PIPE     &mod LGUI AMPS      &mod LALT PRCNT     ___                 ___                 &mod LALT UNDER     &mod LGUI LBRC      &mod LCTRL RBRC     &mod LSHIFT BSLH
                                        ___                 ___                 ___                 ___                 ___                 ___
            >;
        };

        bluetooth {
            bindings = <
___                 ___                 ___                 ___                 ___                 ___                 ___                 ___                 ___                 ___
___                 ___                 ___                 ___                 ___                 ___                 &bt BT_NXT          &bt BT_PRV          ___                 ___
___                 ___                 ___                 ___                 ___                 ___                 ___                 ___                 ___                 &bt BT_CLR
                                        ___                 ___                 ___                 ___                 ___                 ___
            >;
        };
    };
};
